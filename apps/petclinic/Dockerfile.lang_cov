FROM maven:3.9-eclipse-temurin-21 AS appbuilder
ARG PETCLINIC_COMMIT=818c4136ea971c21674525f9053de0d9c7ad8cfe
RUN git clone https://github.com/spring-projects/spring-petclinic.git /src \
    && cd /src \
    && git checkout ${PETCLINIC_COMMIT} \
    && mvn -B -q package -DskipTests -Dmaven.test.skip=true \
    && mkdir -p /out \
    && cp target/*.jar /out/petclinic.jar \
    && cp -r target/classes /out/classes

FROM eclipse-temurin:21-jdk

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential libc6-dev procps iproute2 ca-certificates curl \
        default-mysql-client python3 \
    && rm -rf /var/lib/apt/lists/*

ARG JACOCO_VERSION=0.8.12
RUN mkdir -p /tracelib-support /coverage && chmod 777 /coverage \
    && curl -fsSL -o /tmp/agent.jar "https://repo1.maven.org/maven2/org/jacoco/org.jacoco.agent/${JACOCO_VERSION}/org.jacoco.agent-${JACOCO_VERSION}-runtime.jar" \
    && mv /tmp/agent.jar /tracelib-support/jacocoagent.jar \
    && curl -fsSL -o /tracelib-support/jacococli.jar "https://repo1.maven.org/maven2/org/jacoco/org.jacoco.cli/${JACOCO_VERSION}/org.jacoco.cli-${JACOCO_VERSION}-nodeps.jar"

COPY --from=appbuilder /out/petclinic.jar /app/petclinic.jar
COPY --from=appbuilder /out/classes       /app/classes

COPY common/native-entrypoint.sh     /usr/local/bin/native-entrypoint.sh
COPY java-common/coverage_report.sh  /tracelib-support/coverage_report.sh
COPY apps/petclinic/start.sh              /app/start.sh
RUN chmod +x /usr/local/bin/native-entrypoint.sh \
             /tracelib-support/coverage_report.sh \
             /app/start.sh

ENV TRACELIB_PORT=8098 \
    JACOCO_CLASSFILES=/app/classes \
    JACOCO_AGENT_PORT=6300 \
    JACOCO_AGENT_OPTS="-javaagent:/tracelib-support/jacocoagent.jar=output=tcpserver,address=127.0.0.1,port=6300,includes=org.springframework.samples.petclinic.*" \
    UPSTREAM_ENTRYPOINT=docker-entrypoint.sh

EXPOSE 8098
WORKDIR /app
ENTRYPOINT ["/usr/local/bin/native-entrypoint.sh"]
CMD ["/app/start.sh"]
